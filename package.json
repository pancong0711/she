{
  "name": "she",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false && pnpm --filter @she/pwa typecheck",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "clean": "tsc -b --clean",
    "pack:public": "bash scripts/pack-packages.sh",
    "control-plane": "pnpm --filter @she/control-plane start",
    "broker": "pnpm --filter @she/broker start",
    "pwa:build": "pnpm build && pnpm --filter @she/pwa build",
    "pwa:serve": "pnpm --filter @she/pwa serve",
    "pwa:dev": "pnpm --filter @she/pwa dev"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
