{
  "name": "she",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false && pnpm --filter @she/pwa typecheck",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "clean": "tsc -b --clean",
    "pack:public": "bash scripts/pack-packages.sh",
    "control-plane": "pnpm --filter @she/control-plane start",
    "broker": "pnpm --filter @she/broker start",
    "launcher:build": "bash scripts/build-launcher-asset.sh",
    "home:migrate": "node scripts/migrate-she-home.mjs",
    "pwa:build": "pnpm build && pnpm launcher:build && pnpm --filter @she/pwa build",
    "pwa:serve": "pnpm companion",
    "pwa:dev": "pnpm --filter @she/pwa dev",
    "companion": "pnpm --filter @she/companion start",
    "build:core": "bash scripts/build-core-bundle.sh",
    "install:core": "bash scripts/install-core-bundle.sh",
    "build:feishu-gateway": "pnpm --filter @she/feishu-gateway build",
    "build:companion": "bash scripts/build-companion-bundle.sh",
    "sandbox:fallback-image": "bash scripts/build-sandbox-fallback-image.sh"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
